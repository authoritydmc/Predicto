# Environment & Secrets
.env
.env.*
!.env.example
!.env.template
firebase-service-account.json
service-account.json
firebase.cert.json
*.pem
*.key
*.p12

# Python
venv/
venv*/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
*.manifest
*.spec
*.exe
*.msi

# Node.js / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn-integrity

# Build outputs
frontend/dist/
frontend/.turbo/
frontend/.vite/
frontend/public/version.json
host-app/out/
host-app/release/
host-app/dist/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
firebase-debug.log*
firebase-debug.*.log*

# Databases
*.db
*.sqlite
*.sqlite3
automation_jobs.db

# Firebase
.firebase/
.firebaserc

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Claude local config (not needed for opencode)
.claude/

# AI Agent - keep skills, ignore local state
# .agents/ is intentionally NOT ignored - skills are needed for opencode agent

# Temporary files
tmp/
temp/
scratch/
*.tmp
*.bak
*.cache

# Test coverage
coverage/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Keep these directories (add ! before path to unignore)
!backend/automation/config/
!backend/automation/cron/
!backend/automation/matches/
!backend/automation/scoring/
!backend/automation/scraper/
