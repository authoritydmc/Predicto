{
  "name": "predicto-host",
  "version": "1.0.0",
  "description": "Predicto Host App - Admin/Host interface for prediction management",
  "main": "main.cjs",
  "scripts": {
    "start": "concurrently \"npm --prefix ../frontend run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "start:prod": "NODE_ENV=production electron .",
    "build-win": "electron-builder --win --x64",
    "dist-win": "electron-builder --win --x64 --publish never",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.predicto.host",
    "productName": "Predicto Host",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Predicto Host"
    }
  }
}
