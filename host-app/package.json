{
  "name": "predicto-host",
  "version": "1.0.0",
  "description": "Predicto Host App - Admin/Host interface for prediction management",
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --port 5174\" \"cross-env NODE_ENV=development APP_MODE=local electron .\"",
    "dev:prod": "concurrently \"vite --port 5174\" \"cross-env NODE_ENV=development APP_MODE=prod electron .\"",
    "start": "npm run dev",
    "start:prod": "npm run dev:prod",
    "build": "vite build",
    "build-win": "vite build && electron-builder --win --x64",
    "dist-win": "vite build && electron-builder --win --x64 --publish never",
    "build-mac": "vite build && electron-builder --mac",
    "build-linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "firebase": "^12.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.0.0",
    "vite": "^4.4.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.predicto.host",
    "productName": "Predicto Host",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Predicto Host"
    }
  }
}
