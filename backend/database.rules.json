{
  "rules": {
    ".read": false,
    ".write": false,
    "local": {
      ".read": true,
      ".write": true,
      "tournaments": {
        "$sport": {
          "$tournamentId": {
            ".read": true,
            ".write": true,
            "meta": {
              ".read": true,
              ".write": true
            },
            "predictions": {
              ".read": true,
              ".write": true
            },
            "chat": {
              ".read": true,
              ".write": true
            },
            "reactions": {
              ".read": true,
              ".write": true
            },
            "history": {
              ".read": true,
              ".write": true
            },
            "innings_history": {
              ".read": true,
              ".write": true
            },
            "season_leaderboard": {
              ".read": true,
              ".write": true
            }
          }
        }
      },
      "discovery": {
        "$roomId": {
          ".read": true,
          ".write": true
        }
      },
      "users": {
        "$clientId": {
          ".read": true,
          ".write": true
        }
      },
      "active_sessions": {
        "$roomId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "prod": {
      ".read": false,
      ".write": false,
      "tournaments": {
        "$sport": {
          "$tournamentId": {
            ".read": true,
            "meta": {
              ".read": true,
              ".write": "auth != null && auth.token.admin === true"
            },
            "predictions": {
              ".read": true,
              ".write": "auth != null"
            },
            "chat": {
              ".read": true,
              ".write": "auth != null"
            },
            "reactions": {
              ".read": true,
              ".write": "auth != null"
            },
            "history": {
              ".read": true,
              ".write": "auth != null && auth.token.admin === true"
            },
            "innings_history": {
              ".read": true,
              ".write": "auth != null && auth.token.admin === true"
            },
            "season_leaderboard": {
              ".read": true,
              ".write": "auth != null && auth.token.admin === true"
            }
          }
        }
      },
      "discovery": {
        "$roomId": {
          ".read": true,
          ".write": "auth != null && auth.token.admin === true"
        }
      },
      "users": {
        "$clientId": {
          ".read": "auth != null && auth.uid === $clientId || auth.token.admin === true",
          ".write": "auth != null && auth.uid === $clientId || auth.token.admin === true"
        }
      },
      "active_sessions": {
        "$roomId": {
          ".read": true,
          ".write": "auth != null && auth.token.admin === true"
        }
      }
    }
  }
}