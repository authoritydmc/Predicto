{
  "name": "overlaychat-desktop",
  "version": "1.0.9",
  "description": "Windows overlay app for OverlayChat",
  "author": "OverlayChat",
  "main": "backend/desktop/main.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development APP_MODE=local concurrently \"python backend/server.py\" \"electron .\"",
    "start:dev": "cross-env NODE_ENV=development electron .",
    "start:local": "cross-env NODE_ENV=development APP_MODE=local electron .",
    "start:prod": "cross-env NODE_ENV=production electron .",
    "start:server": "cross-env NODE_ENV=development python backend/server.py",
    "dist:win": "electron-builder --win",
    "deploy": "cd frontend && npm run build && cd .. && firebase deploy",
    "monitor": "cross-env APP_MODE=prod python backend/monitor.py"
  },
  "build": {
    "appId": "com.overlaychat.desktop",
    "productName": "OverlayChat",
    "directories": {
      "buildResources": "backend/desktop"
    },
    "files": [
      "backend/desktop/**/*",
      "frontend/dist/**/*",
      "schedule_2026_ipl.csv",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "37.3.1",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "dotenv": "^16.4.5",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.0.0",
    "ws": "^8.20.0"
  }
}
